# Dependencies
node_modules/

# Secrets: the SAP API key lives here and must never reach GitHub
.env
.env.local

# Build output
dist/
web/dist/

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store

# The live Excel workbook. Not committed because it changes on every approval, it is a
# binary file that git cannot merge, and it would carry real decisions into the repo.
# The JSON files in server/data are the seed; rebuild the workbook with:
#   node server/scripts/build-workbook.js
server/data/procurement.xlsx

# The SAP source-table dumps. Also generated, so also not committed. Rebuild with:
#   node server/scripts/build-sap-dumps.js
server/data/sap-source-tables.xlsx
server/data/*.xlsx.tmp
~$*.xlsx
# The SQLite database. Generated from the workbook, holds real decisions, and binary.
# Recreate with:  node db/migrate.js  then  node db/seed-from-excel.js
db/procurement.db
db/procurement.db-wal
db/procurement.db-shm

# Saved copies of mail settings while switching between providers. Local only.
*.env.*-backup
db/.env.*

# The offline copy. Generated from live data with:
#   node server/scripts/build-standalone.js "your password"
InfraBeat-Dashboard-offline.html

# Working notes that map the invented dashboard names to real people's mailboxes.
# Same reason .env is ignored: these are personal addresses, this repository is public, and
# the whole point of moving the directory into MAIL_DIRECTORY was to stop shipping them.
mailbox_persona_mapping.xlsx
*persona*mapping*.xlsx

# Documents the user has flagged for their own follow-up. Their notes, not the company's
# data, and written at runtime - so it is left out the same way .env is.
server/data/review-flags.json

# Tasks somebody assigned by hand on the team board. Their own working notes, written at
# runtime, not a mirror of anything in SAP.
server/data/team-tasks.json
