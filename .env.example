# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is listed in .gitignore, so your real key and password never get committed.

# Port the Express backend listens on
PORT=3001

# Where the data lives: "excel" (the workbook, the only one that can be written to),
#                       "mock" (read-only JSON), or "sap" (live sandbox).
DATA_SOURCE=excel

# SAP Business Accelerator Hub sandbox
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/
SAP_API_KEY=paste-your-sandbox-api-key-here

# --- Dashboard sign-in ---
# The backend refuses to start without both of these, so it can never serve procurement
# data to whoever happens to find the port.
#
# The password is never stored, only a hash of it. Generate one with:
#   node server/scripts/hash-password.js "your password"
# and paste the line it prints in as AUTH_PASSWORD_HASH.
AUTH_USERNAME=you@example.com
# The name to record and display instead of the sign-in address. The workbook's
# "Decided by" column and the body of every notification use this. Keep it the same as
# APPROVER_NAME in web/src/brand.js so the screen and the record agree.
AUTH_DISPLAY_NAME=Your Name
AUTH_PASSWORD_HASH=run-the-hash-password-script-to-generate-this

# Marks the session cookie as HTTPS-only. Leave false on http://localhost, or the
# browser will refuse the cookie and sign-in will fail with no visible reason.
# Set to true when the dashboard is deployed behind HTTPS.
AUTH_SECURE_COOKIE=false

# --- Email ---
# The dashboard hands each message to a mail server, which does the delivering. That
# handover uses SMTP, so these four lines are: which server, which port, and who you are.
# Recipients need nothing at all - no account, no setup.
#
# Three options, in the order worth trying:
#
# 1. Your company mail server. Best if you have it: mail arrives from a real work address,
#    stays internal, and is not filtered as an outside sender. InfraBeat runs on Microsoft
#    365, so that would be:
#       MAIL_HOST=smtp.office365.com   MAIL_PORT=587   MAIL_USER=you@example.com
#    Ask IT whether SMTP AUTH is enabled on your account - many tenants disable it.
#
# 2. Gmail. Works, but will NOT accept your normal password. You need a 16-character App
#    Password, which needs 2-Step Verification turned on first:
#       https://myaccount.google.com/security       turn on 2-Step Verification
#       https://myaccount.google.com/apppasswords   create one, paste it below
#    Mail from a gmail.com address to a company domain often lands in Junk the first time.
#
# 3. A throwaway test mailbox, for checking the code works without any real account:
#       node server/scripts/make-test-mailbox.js
#    It prints settings to paste here. Every send then returns a preview URL where you can
#    read the message. It delivers to NOBODY, so swap real settings back before a demo.
#
# Leave MAIL_PASSWORD empty and every action still saves. It just sends nothing.
# Whether any mail is sent at all. Everything still saves and is logged when this is
# false - the mail is simply not attempted, and the boot line says so. set to false to silence all mail without losing the credentials.
MAIL_ENABLED=true

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=you@gmail.com
MAIL_PASSWORD=
MAIL_FROM=Procurement Dashboard <you@gmail.com>
MAIL_TO=who-should-be-notified@example.com