# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is listed in .gitignore, so your real key and password never get committed.

# Port the Express backend listens on
PORT=3001

# Where the data lives: "excel" (the workbook, the only one that can be written to),
#                       "mock" (read-only JSON), or "sap" (live sandbox).
DATA_SOURCE=excel

# SAP Business Accelerator Hub sandbox
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/
SAP_API_KEY=paste-your-sandbox-api-key-here

# --- Dashboard sign-in ---
# The backend refuses to start without both of these, so it can never serve procurement
# data to whoever happens to find the port.
#
# The password is never stored, only a hash of it. Generate one with:
#   node server/scripts/hash-password.js "your password"
# and paste the line it prints in as AUTH_PASSWORD_HASH.
AUTH_USERNAME=you@example.com
AUTH_PASSWORD_HASH=run-the-hash-password-script-to-generate-this

# Marks the session cookie as HTTPS-only. Leave false on http://localhost, or the
# browser will refuse the cookie and sign-in will fail with no visible reason.
# Set to true when the dashboard is deployed behind HTTPS.
AUTH_SECURE_COOKIE=false

# --- Email ---
# Approving or rejecting a document sends a notification through this account.
# Gmail will NOT accept your normal password. You need a 16-character App Password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Paste it below with the spaces removed.
# Leave MAIL_PASSWORD empty and approvals still save, they just send no email.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=you@gmail.com
MAIL_PASSWORD=
MAIL_FROM=Procurement Dashboard <you@gmail.com>
MAIL_TO=who-should-be-notified@example.com